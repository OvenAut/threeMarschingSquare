<Window x:Class="WinCCAlarmEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinCC Unified Meldungseditor" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Loaded="Window_Loaded" Drop="Window_Drop" Closing="Window_Closing">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="New_Executed" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAs_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.SaveAs" Modifiers="Ctrl+Shift" Key="S" />
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="AlarmRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasIssue}" Value="True">
                    <Setter Property="Background" Value="#FFFFE4E1" />
                    <Setter Property="ToolTip" Value="{Binding Issue}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AlarmGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="True" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="HeadersVisibility" Value="All" />
            <Setter Property="FrozenColumnCount" Value="2" />
            <Setter Property="AlternatingRowBackground" Value="#FFF5F8FC" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE0E0E0" />
            <Setter Property="ClipboardCopyMode" Value="ExcludeHeader" />
            <Setter Property="RowStyle" Value="{StaticResource AlarmRowStyle}" />
            <Setter Property="EnableRowVirtualization" Value="True" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Command="ApplicationCommands.New" Content="Neu" ToolTip="Neue, leere Meldungsliste (Strg+N)" />
                <Button Command="ApplicationCommands.Open" Content="Öffnen…" ToolTip="Meldungs-Exportdatei (.xlsx) aus dem TIA Portal öffnen (Strg+O)" />
                <Button Command="ApplicationCommands.Save" Content="Speichern" ToolTip="Speichern (Strg+S)" />
                <Button Command="ApplicationCommands.SaveAs" Content="Speichern unter…" ToolTip="Unter neuem Namen speichern (Strg+Umschalt+S)" />
            </ToolBar>
            <ToolBar>
                <Button Content="+ Meldung" Click="Add_Click" ToolTip="Neue Meldung nach der Auswahl einfügen (Strg+Einfg)" />
                <Button Content="Duplizieren" Click="Duplicate_Click" ToolTip="Ausgewählte Meldungen kopieren (Strg+D)" />
                <Button Content="Löschen" Click="Delete_Click" ToolTip="Ausgewählte Meldungen löschen (Entf)" />
                <Button Content="IDs neu nummerieren" Click="Renumber_Click" ToolTip="IDs in der angezeigten Reihenfolge ab 1 vergeben" />
                <Separator />
                <Button Content="Serie erzeugen…" Click="Series_Click" ToolTip="Viele Bitmeldungen auf einmal aus Alarmwörtern erzeugen" />
                <Button Content="Prüfen" Click="Validate_Click" ToolTip="Doppelte IDs/Namen, fehlende Variablen usw. suchen (F5)" />
            </ToolBar>
            <ToolBar>
                <TextBlock Text="Sprachen:" VerticalAlignment="Center" Margin="4,0" />
                <TextBlock x:Name="LanguagesText" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                <Button Content="+ Sprache" Click="AddLanguage_Click" ToolTip="Weitere Textsprache hinzufügen, z. B. en-US" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Expander x:Name="IssuesExpander" DockPanel.Dock="Bottom" Header="Prüfergebnisse" Margin="2">
            <ListBox x:Name="IssuesList" Height="150" MouseDoubleClick="Issues_DoubleClick"
                     ToolTip="Doppelklick springt zur Meldung" />
        </Expander>

        <TabControl x:Name="Tabs" Margin="2">
            <TabItem x:Name="DiscreteTab" Header="Bitmeldungen">
                <DataGrid x:Name="DiscreteGrid" Style="{StaticResource AlarmGridStyle}" />
            </TabItem>
            <TabItem x:Name="AnalogTab" Header="Analogmeldungen">
                <DataGrid x:Name="AnalogGrid" Style="{StaticResource AlarmGridStyle}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
